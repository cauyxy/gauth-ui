{
  "name": "gauth-ui",
  "version": "0.1.0",
  "description": "Gauth design system: tokens, React components and design rules.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cauyxy/gauth-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "design"
  ],
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "compare": "pnpm build && node compare/run.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^31.0.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
