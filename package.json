{
  "name": "gauth-ui",
  "version": "0.4.0",
  "description": "Unofficial design system in the look of gauth.com: tokens, React components and design rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cauyxy/gauth-ui.git"
  },
  "homepage": "https://ui.gauthx.app",
  "bugs": "https://github.com/cauyxy/gauth-ui/issues",
  "keywords": [
    "react",
    "react-components",
    "design-system",
    "ui",
    "tailwindcss",
    "radix-ui",
    "typescript",
    "accessibility",
    "server-components",
    "education"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./math.css": "./dist/math.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "design",
    "GLOSSARY.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "icons": "node scripts/icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "compare": "pnpm build && node compare/run.ts",
    "gallery": "vite gallery",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "artifact": "pnpm build && node artifact/build.ts",
    "artifact:check": "node artifact/check.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.19.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^31.0.0",
    "lucide-react": "1.61.0",
    "marked": "^18.1.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  }
}
